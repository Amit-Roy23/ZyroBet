# ==============================================================================
# ZyroBet App Environment Configuration (.env.example)
# All sensitive credentials use safe placeholders for local dev and CI.
# ==============================================================================

# App Identity & Native IDs
APP_NAME=ZyroBet
APP_SLUG=zyrobet
APP_SCHEME=zyrobet
IOS_BUNDLE_ID=com.zyrobet.app
ANDROID_PACKAGE=com.zyrobet.app
APP_LINK_DOMAIN=zyrobet.app

# EAS & OTA Updates
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Authentication (Google Sign-In & Apple)
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.000000000000-placeholder
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-placeholder.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-placeholder.apps.googleusercontent.com

# Backend (Supabase)
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Monetization (RevenueCat Coin Shop)
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_your_revenuecat_apple_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your_revenuecat_google_key

# Monitoring & Analytics (Sentry & PostHog)
SENTRY_ORG=zyrobet
SENTRY_PROJECT=zyrobet-mobile
EXPO_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
EXPO_PUBLIC_POSTHOG_API_KEY=phc_placeholder_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Android Push (Optional Firebase config path)
# GOOGLE_SERVICES_JSON=./google-services.json

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_MOCK_DATA=true
EXPO_PUBLIC_DEV_TOOLS=true

# Edge Functions & CORS
REWARD_TIMEZONE=UTC
WEB_APP_ORIGIN=https://zyrobet.vercel.app
ALLOWED_ORIGINS=https://zyrobet.vercel.app,http://localhost:8081
